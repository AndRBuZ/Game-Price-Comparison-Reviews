- unless current_user&.author_of?(likeable)
  = button_to "like", polymorphic_path([:like, likeable]), method: :post, remote: true, class: "text-green-500 hover:text-green-700 mr-2"
  = button_to "dislike", polymorphic_path([:dislike, likeable]), method: :post, remote: true, class: "text-red-500 hover:text-red-700 mr-2"
  = likeable.likes_count
