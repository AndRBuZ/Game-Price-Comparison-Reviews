.games
  .container.mx-auto.p-4
    h1.text-2xl.font-bold.mb-4 = 'Games'
    .flex.justify-end
      = form_tag games_path, method: :get, id: "games-form", data: { turbo_frame: "games_view" } do
        .flex.items-center.justify-end.gap-4
          select#view-type name="view_type" class="border rounded-md p-1" onchange="this.form.submit()"
            - current_view = params[:view_type].presence || "tile"
            option(value="tile" selected=(current_view == "tile")) Tile
            option(value="list" selected=(current_view == "list")) List

          button#filter-toggle type="button" class="flex items-center p-2 bg-gray-200 rounded focus:outline-none" onclick="document.getElementById('filter-menu').classList.toggle('hidden')"
            svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"
              path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"
            span.ml-2 Filters

        div#filter-menu.hidden.mt-4.p-4.bg-white.rounded.shadow.w-64
          button#genre-toggle type="button" class="block text-sm font-medium text-gray-700 w-full text-left flex items-center justify-between" onclick="document.getElementById('genre-list').classList.toggle('hidden')"
            span Genre:
            svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transform transition-transform" viewBox="0 0 20 20" fill="currentColor"
              path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 10.94l3.71-3.71a.75.75 0 111.06 1.06l-4.24 4.24a.75.75 0 01-1.06 0L5.23 8.27a.75.75 0 01.02-1.06z" clip-rule="evenodd"

          div#genre-list.hidden.mt-1.p-2.bg-gray-100.rounded
            - @genre_names.each do |genre_name|
              .flex.items-center.mb-1
                = check_box_tag "genres[]", genre_name, class: "rounded border-gray-300 text-indigo-600 focus:ring-indigo-500"
                label.ml-2.text-sm.text-gray-700 = genre_name

          button#marketplace-toggle type="button" class="block text-sm font-medium text-gray-700 w-full text-left flex items-center justify-between" onclick="document.getElementById('marketplace-list').classList.toggle('hidden')"
            span Marketplaces:
            svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transform transition-transform" viewBox="0 0 20 20" fill="currentColor"
              path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 10.94l3.71-3.71a.75.75 0 111.06 1.06l-4.24 4.24a.75.75 0 01-1.06 0L5.23 8.27a.75.75 0 01.02-1.06z" clip-rule="evenodd"

          div#marketplace-list.hidden.mt-1.p-2.bg-gray-100.rounded
            - @marketplace_names.each do |marketplace_name|
              .flex.items-center.mb-1
                = check_box_tag "marketplaces[]", marketplace_name, class: "rounded border-gray-300 text-indigo-600 focus:ring-indigo-500"
                label.ml-2.text-sm.text-gray-700 = marketplace_name

          button type="submit" class="w-full py-2 px-4 bg-indigo-600 text-white rounded hover:bg-indigo-700 focus:outline-none" onclick="document.getElementById('filter-menu').classList.toggle('hidden')"
           | Apply filters

    = turbo_frame_tag 'games_view' do
      - if @view_type == "tile"
        = render partial: "games/game_tile_view", locals: { games: @games }
      - else
        = render partial: "games/game_list_view", locals: { games: @games }
